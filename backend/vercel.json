{
    "buildCommand": "pip install -r requirements.txt",
    "outputDirectory": ".",
    "functions": {
        "api/index.py": {
            "memory": 3008,
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.py?path=/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.py?path=/$1"
        }
    ]
}